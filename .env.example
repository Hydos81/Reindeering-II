# Đêm Nhạc Thiện Nguyện — mẫu biến môi trường
# Sao chép file này thành .env.local rồi điền giá trị thật.

# URL công khai của web (dùng khi tạo link trong Zalo và QR).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mật khẩu quản trị. Bắt buộc khi chạy production.
ADMIN_PASSWORD=doi-mat-khau-nay

# Các chuỗi bí mật dài tối thiểu 16 ký tự (nên tạo ngẫu nhiên).
ADMIN_SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-hon-16-ky-tu
STAFF_ACTION_SECRET=thay-bang-chuoi-ngau-nhien-dai-hon-16-ky-tu

# Xác thực webhook Google Sheets / Apps Script.
# Bắt buộc trong production (tối thiểu 16 ký tự) — không có giá trị mặc định.
SHEETS_WEBHOOK_SECRET=thay-bang-mot-chuoi-bi-mat-khac

# Zalo Bot Platform (https://bot.zaloplatforms.com/).
ZALO_BOT_TOKEN=
# Có thể dán chat ID tại /admin/connect; biến này chỉ là phương án dự phòng.
ZALO_CHAT_ID=
# Bắt buộc trong production (tối thiểu 16 ký tự) — không có giá trị mặc định.
ZALO_WEBHOOK_SECRET=thay-bang-mot-chuoi-bi-mat-khac

# Supabase — bỏ trống để dùng SQLite cục bộ ở chế độ phát triển.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images

# Đường dẫn database SQLite cục bộ.
SQLITE_PATH=data/app.db

# Thông tin hiển thị trên trang khách.
NEXT_PUBLIC_EVENT_NAME=Đêm Nhạc Thiện Nguyện
NEXT_PUBLIC_EVENT_TAGLINE=Một đêm nhạc, một ly nước, một tấm lòng
NEXT_PUBLIC_EVENT_VENUE=Sân khấu chính · Quán cà phê
